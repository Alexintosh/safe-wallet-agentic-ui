{
  "name": "safe-wallet-agentic-ui",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build-agent-safe.ts",
    "typecheck": "tsc --noEmit -p tsconfig.agent-safe.json",
    "test": "bun test tests/agent-safe",
    "check": "bun run typecheck && bun test tests/agent-safe",
    "test:browser": "NO_SIM=1 bun tests/agent-safe/browser.e2e.ts"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "8.0.4",
    "@safe-global/types-kit": "4.0.1",
    "viem": "2.55.1",
    "elysia": "1.4.29",
    "@elysia/openapi": "1.4.15"
  },
  "devDependencies": {
    "@metamask/eth-sig-util": "9.0.0",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "playwright": "1.58.2"
  },
  "engines": {
    "bun": ">=1.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexintosh/safe-wallet-agentic-ui.git"
  }
}
